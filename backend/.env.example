# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3001
NODE_ENV=production

# Chrome Web Store id of the published extension (32 lowercase letters a-p).
# When set, chrome-extension://<EXTENSION_ID> is the ONLY extension origin allowed
# by CORS. Leave empty only for local unpacked testing, where any chrome-extension://
# origin is accepted.
EXTENSION_ID=

# Extra allowed browser origins, comma separated. Optional.
# https://www.youtube.com and https://youtube.com are always allowed; "*" is ignored.
# Localhost dev origins are allowed automatically when NODE_ENV is not "production".
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Anonymous deployment mode
# ---------------------------------------------------------------------------
# TODO: Set AUTH_DISABLED=false later when Clerk/JWT auth is re-enabled.
AUTH_DISABLED=true

# NOTE: there is no GUEST_USER_ID setting any more. Unauthenticated callers are
# identified per extension installation via the X-Install-Id header (`anon:<uuid>`),
# falling back to their IP address (`ip:<addr>`). Data and quotas are never shared
# across users.

# Allow "dev:<userId>" bearer tokens in production. Keep this OFF for public deploys.
ALLOW_DEV_AUTH=false

# ---------------------------------------------------------------------------
# AI providers
#
# Split of responsibilities:
#   Gemini -> embeddings ONLY (gemini-embedding-001), for Pinecone indexing and
#             query embedding at retrieval time. It never generates text.
#   Groq   -> ALL text generation: chat answers, /api/ai/generate (notes, summaries,
#             chapters, flashcards, quizzes, study agent) and transcript translation.
#
# Both keys are REQUIRED in production; the server refuses to start without them.
# ---------------------------------------------------------------------------

# Embeddings. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Text generation. https://console.groq.com/keys
GROQ_API_KEY=

# Groq chat model used for every text generation call.
# Must be a chat-completions model available on your Groq account. If the configured
# model is decommissioned, the backend discovers a live replacement automatically.
GROQ_MODEL=openai/gpt-oss-20b

# Vector DB (Pinecone)
# NOTE: the index must have 3072 dimensions to match gemini-embedding-001.
PINECONE_API_KEY=
PINECONE_INDEX=yt-studyflow
PINECONE_NAMESPACE=prod

# ---------------------------------------------------------------------------
# Database (optional for anonymous/local-first deployment; needed for cloud sync)
# ---------------------------------------------------------------------------
DATABASE_URL=
DIRECT_URL=

# ---------------------------------------------------------------------------
# Abuse protection
# ---------------------------------------------------------------------------
# Shared window for both rate limiters, in milliseconds.
RATE_LIMIT_WINDOW_MS=60000

# Requests per window per extension install (or per signed-in user).
RATE_LIMIT_MAX_PER_WINDOW=60

# Requests per window per IP address, applied on top of the per-install limit.
# Should be comfortably higher, so shared networks (campus, office) are not blocked
# while a single host still cannot mint unlimited install ids.
IP_RATE_LIMIT_MAX_PER_WINDOW=240

# AI actions per user per day.
DAILY_QUOTA_MAX=500

# ---------------------------------------------------------------------------
# Auth (future only)
# ---------------------------------------------------------------------------
# TODO: Fill these and set AUTH_DISABLED=false when login/signup is re-enabled.
# CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
