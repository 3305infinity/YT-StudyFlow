# Server
PORT=3001
NODE_ENV=production
CORS_ORIGINS=chrome-extension://YOUR_EXTENSION_ID,https://www.youtube.com,https://youtube.com

# Anonymous deployment mode
# TODO: Set AUTH_DISABLED=false later when Clerk/JWT auth is re-enabled.
AUTH_DISABLED=true
GUEST_USER_ID=guest-single-user

# AI
GEMINI_API_KEY=

# Vector DB (Pinecone)
PINECONE_API_KEY=
PINECONE_INDEX=yt-studyflow
PINECONE_NAMESPACE=prod

# Database (optional for anonymous/local-first deployment; needed later for cloud sync)
DATABASE_URL=
DIRECT_URL=

# Rate limits for the anonymous guest user
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_PER_WINDOW=60
DAILY_QUOTA_MAX=500

# Auth (future only)
# TODO: Fill these and set AUTH_DISABLED=false when login/signup is re-enabled.
# CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
