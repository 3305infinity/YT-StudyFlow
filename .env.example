# Chrome extension build
#
# Your deployed Express backend. Optional: production builds default to
# https://yt-studyflow.onrender.com (see src/lib/config/api.config.ts).
#
# If you point this at a different host you MUST also add that host to
# host_permissions in public/manifest.json — the background service worker only
# proxies requests whose origin matches this value, and Chrome only grants network
# access to hosts listed in the manifest.
VITE_API_BASE_URL=https://yt-studyflow.onrender.com

# NOTE: VITE_AUTH_WEB_URL was removed. The hosted sign-in flow is disabled, and the
# code that used it has been deleted. Re-add it when auth returns.
